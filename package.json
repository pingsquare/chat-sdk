{
  "name": "@pingsquare/chat",
  "version": "0.1.0",
  "description": "Website chat widget and headless client for PingSquare",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pingsquare/chat-sdk.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "size": "node scripts/size.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run size"
  },
  "devDependencies": {
    "jsdom": "25.0.1",
    "tsup": "8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
